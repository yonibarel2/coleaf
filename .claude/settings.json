{
  "enabledPlugins": {
    "typescript-lsp@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true
  },
  "permissions": {
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}

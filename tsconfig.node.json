{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "tests/**/*",
    "compliance/**/*.mts"
  ],
  "compilerOptions": {
    "composite": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["electron-vite/node"]
  }
}

{
  "name": "coleaf",
  "version": "0.1.0",
  "description": "Word-style editing of a repo's Markdown files, with simple Git.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --remoteDebuggingPort=9222",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "compliance": "node compliance/run.mts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "ignore": "^7.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@handlewithcare/remark-prosemirror": "^0.1.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "gemoji": "^8.1.0",
    "katex": "^0.19.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.57.0",
    "mdast-util-to-markdown": "^2.2.0",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "prosemirror-search": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
